{
    "name": "uzapoint/reporting-contracts",
    "description": "UzaPoint reporting contracts: the typed snapshot and event payloads every microservice publishes to the Reports service. Owns WHAT UzaPoint reports; sammy-boy/laravel-reporting owns HOW it is published.",
    "keywords": [
        "uzapoint",
        "reporting",
        "contracts",
        "dto",
        "laravel-data",
        "microservices"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/uzapoint/reporting-contracts",
    "support": {
        "issues": "https://github.com/uzapoint/reporting-contracts/issues",
        "source": "https://github.com/uzapoint/reporting-contracts"
    },
    "authors": [
        {
            "name": "Sammy Orondo",
            "email": "sammyorondo2@gmail.com",
            "homepage": "https://github.com/sammy-boy",
            "role": "Lead Developer & Package Maintainer"
        }
    ],
    "require": {
        "php": "^8.4",
        "sammy-boy/laravel-reporting": "^1.0",
        "spatie/laravel-data": "^4.18"
    },
    "require-dev": {
        "laravel/framework": "^11.0|^12.0|^13.0",
        "orchestra/testbench-core": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Uzapoint\\ReportingContracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uzapoint\\ReportingContracts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
